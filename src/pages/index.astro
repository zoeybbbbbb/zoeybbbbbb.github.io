---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="zh-cn">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Zoey's Art Gallery</title>
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body class="min-h-screen flex flex-col bg-white">
    <Header />

    <main class="flex-1 max-w-6xl mx-auto px-4 py-12 w-full">
      <section class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-800 mb-4">欢迎来到 Zoey 的艺术世界</h2>
        <p class="text-lg text-gray-600">这里收录了Zoey每一天的创意作品</p>
        <a href="/gallery" class="inline-block mt-6 px-8 py-3 bg-pink-500 text-white rounded-full hover:bg-pink-600 transition-colors">
          查看作品集
        </a>
      </section>
    </main>

    <Footer />
  </body>
</html>
